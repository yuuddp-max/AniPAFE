NEXT_PUBLIC_SUPABASE_URL=https://YOUR_NEW_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
APP_ORIGIN=http://localhost:3000
# CLI import only; never NEXT_PUBLIC. Prefer a new project's secret key.
SUPABASE_SECRET_KEY=
# Safety guard: import scripts refuse any other project URL.
ANIPAFE_PROJECT_REF=YOUR_NEW_PROJECT
# Only when using Docker/local Supabase; never NEXT_PUBLIC.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
